<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- CAPA 1: IMAGEN DE FONDO A PANTALLA COMPLETA -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/canva_final" />

    <!-- CAPA 2: CAJA BLANCA MINIMALISTA -->
    <LinearLayout
        android:id="@+id/cajaLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:layout_marginBottom="40dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Texto de bienvenida -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¡Bienvenido!"
            android:textAlignment="center"
            android:textColor="#212121"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Descubre los mejores sabores del mundo sin salir de Zaragoza."
            android:textAlignment="center"
            android:textColor="#757575"
            android:textSize="14sp" />

        <!-- FILA: LOGO DE GOOGLE + BOTÓN INVITADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Botón de la imagen de Google -->
            <ImageButton
                android:id="@+id/btnGoogle"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:background="#FFFFFF"
                android:elevation="15dp"
                android:padding="5dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/icono_google" />

            <!-- Espacio en blanco para separar el logo del botón de invitado -->
            <Space
                android:layout_width="16dp"
                android:layout_height="wrap_content" />

            <!-- Botón de Invitado -->
            <Button
                android:id="@+id/btnInvitado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#212121"
                app:cornerRadius="12dp"
                android:textStyle="bold"
                android:text="Entrar como invitado"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>