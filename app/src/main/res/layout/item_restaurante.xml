<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <!-- Imagen del restaurante -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgRestauranteItem"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent"
            app:srcCompat="@drawable/canva_final" />

        <!-- Nombre del restaurante -->
        <TextView
            android:id="@+id/tvNombreRestauranteItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Nombre del Restaurante"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/imgRestauranteItem"
            app:layout_constraintTop_toTopOf="@+id/imgRestauranteItem" />

        <!-- Valoración (Estrellas) -->
        <TextView
            android:id="@+id/tvValoracionItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="⭐ 4.5"
            android:textColor="#F4B400"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@+id/tvNombreRestauranteItem"
            app:layout_constraintTop_toBottomOf="@+id/tvNombreRestauranteItem" />

        <!-- Distancia (Simulada por ahora) -->
        <TextView
            android:id="@+id/tvDistanciaItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="• 2,23 km"
            android:textColor="#757575"
            app:layout_constraintBottom_toBottomOf="@+id/tvValoracionItem"
            app:layout_constraintStart_toEndOf="@+id/tvValoracionItem"
            app:layout_constraintTop_toTopOf="@+id/tvValoracionItem" />

        <!-- Eslogan o descripción corta -->
        <TextView
            android:id="@+id/tvEsloganItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sabor casero y tradición"
            android:textColor="#757575"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvNombreRestauranteItem"
            app:layout_constraintTop_toBottomOf="@+id/tvValoracionItem" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>