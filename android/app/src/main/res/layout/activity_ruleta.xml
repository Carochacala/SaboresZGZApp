<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎰 RULETA GASTRONÓMICA"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/colorBase"
        android:layout_marginBottom="16dp" />

    <ImageView
        android:id="@+id/ivRuleta"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ruleta"
        android:layout_marginBottom="16dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <TextView
            android:id="@+id/tvResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎲 Toca GIRAR"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="20dp"
            android:minHeight="100dp" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📌 Filtrar por tipo de cocina"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:id="@+id/layoutFiltros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <Button
        android:id="@+id/btnGirar"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:text="🎲 GIRAR"
        android:backgroundTint="@color/colorBase"
        android:textSize="20sp"
        android:textStyle="bold" />

</LinearLayout>