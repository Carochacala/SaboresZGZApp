<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sabores_ZGZ">
        <activity
            android:name=".RegistroActivity"
            android:exported="false" />
        <activity
            android:name=".HomeActivity"
            android:exported="false" /> <!-- Pantalla de selección de tipo de comida -->
        <activity
            android:name=".TiposComidaActivity"
            android:exported="false" /> <!-- Pantalla de restaurantes -->

        <activity
            android:name=".RestauranteActivity"
            android:exported="false" /> <!-- MainActivity, punto de entrada -->
        <activity
            android:name=".DetallePais"
            android:exported="false" />
        <activity
            android:name=".DetallePlato"
            android:exported="false" />
        <activity
            android:name=".DetalleRestaurante"
            android:exported="false" />
        <activity
            android:name=".SeleccionRestaurantes"
            android:exported="false" />
        <activity
            android:name=".SeleccionPais"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>